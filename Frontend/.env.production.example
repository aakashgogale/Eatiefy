# Copy to .env.production before `npm run build` on the server or CI.
# NEVER use localhost values in production builds — the bundle is static, so
# whatever is here is baked into dist/ and shipped to every browser.

# API (required) — use your live domain
VITE_API_BASE_URL=https://eatiefy.com/api/v1

# Socket.IO origin (optional).
# Leave unset when sockets are served from the same host as the API — the client
# derives the origin from VITE_API_BASE_URL. Set it only when Socket.IO lives on a
# different host/port than the REST API.
# VITE_SOCKET_URL=https://eatiefy.com

# Uploaded images served by nginx at /uploads/
VITE_UPLOAD_BASE_URL=https://eatiefy.com/uploads

# Google Maps browser key (required) — loads the Maps JS SDK and Places
# autocomplete used by the location picker and the address search boxes.
# Omitting it does not raise an error: the map silently never initialises and
# address search falls back to coarse results, which looks like "location is
# broken in production" while it works locally.
# Restrict this key by HTTP referrer to your live domain, and enable:
# Maps JavaScript API + Places API. It is NOT the server key — the backend uses
# its own unrestricted GOOGLE_MAPS_API_KEY for geocoding.
VITE_GOOGLE_MAPS_API_KEY=
